# OpenRouter API Key (Required for LLM Brain)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model identifier (Default: free tier)
ULTRON_MODEL=openrouter/free

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ElevenLabs Voice Synthesis (Optional - set to true to enable voice)
ENABLE_VOICE=false
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
